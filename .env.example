# Supabase Dashboard > Project Settings > API에서 확인합니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 카카오디벨로퍼스 앱의 JavaScript 키를 사용합니다.
VITE_KAKAO_MAP_JS_KEY=your-kakao-javascript-key

# Vercel 함수와 `vercel dev`에서만 읽습니다. VITE_ 접두사를 붙이지 않습니다.
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# TMAP 대중교통 Premium 앱 키입니다. Vercel 함수와 로컬 `vercel dev`에서만 읽습니다.
TMAP_TRANSIT_APP_KEY=your-tmap-transit-app-key

# 이 Supabase 사용자 ID와 일치하는 로그인 사용자만 TMAP을 호출할 수 있습니다.
TMAP_TRANSIT_ALLOWED_USER_ID=your-supabase-user-uuid

# Production 유료 호출은 허용 사용자 검증 후에만 명시적으로 true로 설정합니다.
TMAP_TRANSIT_PRODUCTION_ENABLED=false

# Vercel 함수의 사용자 토큰 검증용입니다. 없으면 기존 VITE_ 값을 사용합니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 실제 Supabase 프로젝트 설정과 일치해야 합니다.
VITE_EMAIL_OTP_LENGTH=6
