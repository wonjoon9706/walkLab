# Supabase Dashboard > Project Settings > API에서 확인합니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# MapTiler에서 만든 공개 스타일 URL과 공개 API 키를 사용합니다.
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json
VITE_MAPTILER_API_KEY=your-public-maptiler-key

# 실제 Supabase 프로젝트 설정과 일치해야 합니다.
VITE_EMAIL_OTP_LENGTH=6
