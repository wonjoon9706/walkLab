# Production/Preview 서버 카카오 검색·출입구 검색 허용. 운영 검증 후에만 true.
KAKAO_TRANSIT_PRODUCTION_ENABLED=false

# Supabase Dashboard > Project Settings > API에서 확인합니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 카카오디벨로퍼스 앱의 JavaScript 키를 사용합니다.
VITE_KAKAO_MAP_JS_KEY=your-kakao-javascript-key

# Vercel 함수와 `vercel dev`에서만 읽습니다. VITE_ 접두사를 붙이지 않습니다.
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# 이 Supabase 사용자 UUID와 일치하는 로그인 사용자만 대중교통 서버 API를 호출합니다.
TRANSIT_ALLOWED_USER_ID=your-supabase-user-uuid

# 공공데이터포털 TAGO 버스도착정보·버스정류소정보 일반 인증키(Decoding)를 사용합니다.
# VITE_ 접두사를 붙이지 않고 /api/tago/bus-arrival 서버 함수에서만 읽습니다.
# 같은 키에 TAGO 버스도착정보·버스정류소정보·버스노선정보 승인이 모두 필요합니다.
TAGO_SERVICE_KEY=your-data-go-kr-service-key

# 로컬 검증 중에는 false를 유지합니다. Production 실제 호출만 명시적으로 차단합니다.
TAGO_BUS_ARRIVAL_PRODUCTION_ENABLED=false

# 로컬에서 실제 응답 원문·인증 URL 없이 단계별 매칭 결과만 화면에 표시합니다.
# Production에서는 true여도 무시됩니다.
TAGO_BUS_ARRIVAL_DIAGNOSTICS_ENABLED=false

# 서울시 버스 API는 HTTP 실측만 확인되어 로컬 Vercel 함수에서만 명시적으로 켭니다.
SEOUL_BUS_API_LOCAL_ENABLED=false

# 비워 두면 기존 TAGO_SERVICE_KEY를 재사용합니다. 별도 승인을 받은 키가 있으면 설정합니다.
SEOUL_BUS_SERVICE_KEY=

# 서울시 지하철 API는 현재 HTTP 실측만 완료되어 로컬 Vercel 함수에서만 사용합니다.
# 브라우저에 노출되지 않도록 VITE_ 접두사를 사용하지 않습니다.
SEOUL_SUBWAY_REALTIME_KEY=
SEOUL_SUBWAY_REALTIME_LOCAL_ENABLED=false

# Vercel 함수의 사용자 토큰 검증용입니다. 없으면 기존 VITE_ 값을 사용합니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 실제 Supabase 프로젝트 설정과 일치해야 합니다.
VITE_EMAIL_OTP_LENGTH=6
