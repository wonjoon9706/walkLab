{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "src/domain/busArrival.ts",
    "src/domain/walkingRoute.ts",
    "src/domain/walkingSpeedModel.ts",
    "src/domain/transitRoute.ts",
    "src/services/routing/kakaoWalkingRouteParser.ts",
    "src/services/routing/tmapTransitRouteParser.ts",
    "src/services/transitArrival/tagoResponseParser.ts",
    "src/services/transitArrival/tagoRouteDirection.ts",
    "src/services/transitArrival/tagoStopMatcher.ts"
  ]
}
